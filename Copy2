-----------------------------------------------
-- ฟังก์ชันบังคับเชื่อมเครื่องประดับ (Force Weld)
-----------------------------------------------
local function ForceEquipAccessory(myChar, accessory)
	local handle = accessory:FindFirstChild("Handle")
	if not handle then return end

	for _, child in ipairs(handle:GetChildren()) do
		if child:IsA("JointInstance") or child:IsA("Weld") or child:IsA("WeldConstraint") then
			child:Destroy()
		end
	end

	handle.Anchored = false
	handle.CanCollide = false

	local accAttachment = handle:FindFirstChildOfClass("Attachment")
	if not accAttachment then 
		local hum = myChar:FindFirstChildOfClass("Humanoid")
		if hum then hum:AddAccessory(accessory) end
		return
	end

	local targetPart = nil
	local targetAttachment = nil

	for _, part in ipairs(myChar:GetDescendants()) do
		if part:IsA("BasePart") then
			local att = part:FindFirstChild(accAttachment.Name)
			if att and att:IsA("Attachment") then
				targetPart = part
				targetAttachment = att
				break
			end
		end
	end

	if targetPart and targetAttachment then
		accessory.Parent = myChar
		
		local weld = Instance.new("Weld")
		weld.Name = "AccessoryWeld"
		weld.Part0 = targetPart
		weld.Part1 = handle
		weld.C0 = targetAttachment.CFrame
		weld.C1 = accAttachment.CFrame
		weld.Parent = handle
	else
		local hum = myChar:FindFirstChildOfClass("Humanoid")
		if hum then hum:AddAccessory(accessory) end
	end
end

-----------------------------------------------
-- ฟังก์ชันสวมชุดทั้งหมด
-----------------------------------------------
local function CopyOutfitFromModel(sourceModel)
	local myChar = LocalPlayer.Character
	if not myChar or not sourceModel then return end
	
	local myHead = myChar:FindFirstChild("Head")
	
	-- ถอดของเก่าทิ้ง
	for _, item in ipairs(myChar:GetChildren()) do
		if item:IsA("Accessory") or item:IsA("Accoutrement") or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") then
			item:Destroy()
		end
	end
	
	if myHead then
		for _, item in ipairs(myHead:GetChildren()) do
			if item:IsA("Decal") then item:Destroy() end
		end
	end
	
	-- ใส่ของใหม่
	for _, item in ipairs(sourceModel:GetChildren()) do
		if item:IsA("Accessory") or item:IsA("Accoutrement") then
			local clone = item:Clone()
			ForceEquipAccessory(myChar, clone)
			
		elseif item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") then
			item:Clone().Parent = myChar
			
		elseif item:IsA("Decal") then
			if myHead then item:Clone().Parent = myHead end
		end
	end
end

-----------------------------------------------
-- ปุ่มกดค้นหาและดึงชุด
-----------------------------------------------
CopyCustomBtn.MouseButton1Click:Connect(function()
	local targetName = UsernameBox.Text
	if targetName == "" then return end

	CopyCustomBtn.Text = "กำลังโหลด..."
	
	task.spawn(function()
		local success, userId = pcall(function()
			return Players:GetUserIdFromNameAsync(targetName)
		end)

		if success and userId then
			local appearanceModel
			local modelSuccess, _ = pcall(function()
				appearanceModel = Players:GetCharacterAppearanceAsync(userId)
			end)
			
			if modelSuccess and appearanceModel then
				CopyOutfitFromModel(appearanceModel)
				appearanceModel:Destroy()
				CopyCustomBtn.Text = "ดึงชุดสำเร็จ!"
			else
				CopyCustomBtn.Text = "โหลดชุดล้มเหลว"
			end
		else
			CopyCustomBtn.Text = "ไม่พบชื่อผู้เล่นนี้"
		end
		
		task.wait(2)
		CopyCustomBtn.Text = "ดึงชุดจากชื่อที่พิมพ์"
	end)
end)

